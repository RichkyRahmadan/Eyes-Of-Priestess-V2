# URL Base Backend API Gateway (Opsional jika menggunakan reverse proxy /api/v1)
# Contoh produksi di Vercel:
# PUBLIC_API_BASE_URL=https://api.eyesofpriestess.com/api/v1
# Atau jika menggunakan Railway / Fly.io / VPS:
# PUBLIC_API_BASE_URL=https://your-backend-domain.up.railway.app/api/v1
PUBLIC_API_BASE_URL=

# WebSocket Endpoint untuk Real-time Chat
# Contoh: wss://your-backend-domain.up.railway.app/ws/chat
PUBLIC_WS_URL=ws://127.0.0.1:8084/ws/chat
