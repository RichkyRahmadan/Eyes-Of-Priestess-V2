# ==============================================================================
# Eyes of Priestess V2 — Root Environment Template
# Copy this file to .env before running docker-compose or local services
# ==============================================================================

# Database Configuration
POSTGRES_USER=priestess
POSTGRES_PASSWORD=originium_seal
POSTGRES_DB=eyesofpriestess
POSTGRES_PORT=5435

# Redis Cache
REDIS_PORT=6379

# RabbitMQ Message Broker
RABBITMQ_DEFAULT_USER=priestess
RABBITMQ_DEFAULT_PASS=originium_seal
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Gateway & API
KONG_HTTP_PORT=8000
KONG_ADMIN_PORT=8001

# Payment Gateway (Xendit Sandbox / Production)
# Replace with your actual Xendit Development Keys from dashboard.xendit.co
XENDIT_API_KEY=xnd_development_YOUR_SANDBOX_KEY_HERE
XENDIT_WEBHOOK_TOKEN=YOUR_WEBHOOK_VERIFICATION_TOKEN_HERE
XENDIT_CALLBACK_URL=https://your-public-tunnel-url.loca.lt

# Frontend Environment (Vercel / Local)
PUBLIC_API_BASE_URL=http://localhost:8000
