# ═══════════════════════════════════════════════════════════════════════════════
# EyesOfPriestess — The Covenant Protocol
# Environment Variables Template
# Copy this to .env and fill in real values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── The Archive (PostgreSQL) ────────────────────────────────────────────────
POSTGRES_DB=eyesofpriestess
POSTGRES_USER=priestess
POSTGRES_PASSWORD=originium_seal

# ─── The Crystal (Redis) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── The Aether (RabbitMQ) ───────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=priestess
RABBITMQ_PASSWORD=originium_seal

# ─── Sacred Seal (JWT) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=originium-256-bit-secret-key-min-32-chars-CHANGE-IN-PRODUCTION
JWT_ACCESS_EXPIRY=900        # 15 minutes in seconds
JWT_REFRESH_EXPIRY=604800    # 7 days in seconds

# ─── Offering Channels (Payment Gateways — Sandbox) ──────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE-WITH-YOUR-KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE-WITH-YOUR-KEY
XENDIT_API_KEY=xnd_development_REPLACE-WITH-YOUR-KEY

# ─── The Sanctum (Application) ───────────────────────────────────────────────
APP_NAME=EyesOfPriestess
APP_ENV=development
APP_DEBUG=true
PUBLIC_API_URL=http://localhost:8080
